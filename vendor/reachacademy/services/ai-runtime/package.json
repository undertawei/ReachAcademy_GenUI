{
  "name": "@reachany/ai-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "accept:clone-speech-harness": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/reach-deck-player --filter @reachany/reach-deck-editor build && tsx scripts/reach-deck/run-clone-speech-harness.ts",
    "accept:generation-offline": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/reach-deck-player build && tsx scripts/reach-deck/run-offline-generation-acceptance.ts",
    "accept:generation-offline:batch": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/reach-deck-player build && tsx scripts/reach-deck/run-offline-generation-batch.ts",
    "accept:interactive-science-kits": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/reach-deck-player build && tsx scripts/reach-deck/run-interactive-science-kit-acceptance.ts",
    "accept:player-harness": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/reach-deck-player build && tsx scripts/reach-deck/run-player-harness.ts",
    "accept:pptx-import-harness": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/auth --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/importer --filter @reachany/reach-deck-player build && tsx scripts/reach-deck/run-pptx-import-harness.ts",
    "accept:word-import-harness": "pnpm --filter @reachany/ai-runtime-feedforward lint && pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/auth --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/importer --filter @reachany/reach-deck-player build && tsx scripts/word-import/run-word-import-harness.ts",
    "build": "pnpm run build:workspace-deps && next build --webpack && node scripts/reach-deck/prepare-runtime-standalone.mjs && node scripts/reach-deck/verify-geometry-production-resolution.mjs && node scripts/reach-deck/verify-maic-production-fonts.mjs",
    "build:workspace-deps": "node scripts/build-workspace-deps.mjs",
    "dev": "pnpm run build:workspace-deps && next dev --webpack --hostname 127.0.0.1 --port 3050",
    "eval:decksmith": "pnpm run build:workspace-deps && tsx scripts/reach-deck/decksmith-eval/run-decksmith-eval.ts",
    "eval:decksmith:integration": "pnpm run build:workspace-deps && tsx scripts/reach-deck/decksmith-eval/run-decksmith-integration.ts",
    "evaluate:layouts": "tsx scripts/reach-deck/evaluate-slide-layouts.ts",
    "export:word": "pnpm --filter @reachany/reach-deck-dsl --filter @reachany/importer build && tsx scripts/word-import/run-local-export.ts",
    "harness:content": "tsx scripts/reach-deck/run-deck-harness-content.ts",
    "harness:deck": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/reach-deck-player --filter @reachany/reach-deck-bff --filter @reachany/reach-deck-client build && tsx scripts/reach-deck/run-deck-harness.ts",
    "lint": "tsc -p tsconfig.lint.json --noEmit",
    "probe:narration-chunks": "tsx scripts/reach-deck/run-narration-chunk-probe.ts",
    "render:layout-examples": "pnpm --filter @reachany/brand --filter @reachany/ui --filter @reachany/clipboard-content --filter @reachany/reach-deck-dsl --filter @reachany/reach-deck-rich-text --filter @reachany/tiptap-mathlive --filter @reachany/reach-deck-player build && node scripts/reach-deck/render-layout-examples.mjs",
    "start": "next start",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:worker-lifecycle:process": "node scripts/worker-lifecycle-smoke.mjs",
    "worker": "pnpm run build:workspace-deps && tsx worker.ts",
    "worker:probe": "node worker-probe.mjs",
    "worker:metrics": "node --import tsx queue-metrics.mjs"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@prometheus-io/client": "0.16.1",
    "@reachany/ai-runtime-common": "workspace:*",
    "@reachany/ai-runtime-feedforward": "workspace:*",
    "@reachany/auth": "workspace:*",
    "@reachany/importer": "workspace:*",
    "@reachany/observability": "workspace:*",
    "@reachany/reach-deck-bff": "workspace:*",
    "@reachany/reach-deck-client": "workspace:*",
    "@reachany/reach-deck-dsl": "workspace:*",
    "@reachany/reach-deck-geometry": "workspace:*",
    "@reachany/reach-deck-player": "workspace:*",
    "@reachany/reach-deck-rich-text": "workspace:^",
    "@reachany/tiptap-mathlive": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "@tiptap/core": "3.28.0",
    "@tiptap/html": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "acorn": "8.16.0",
    "bullmq": "5.77.3",
    "esbuild": "0.27.7",
    "expr-eval-fork": "3.0.3",
    "fontkit": "2.0.4",
    "function-plot": "1.25.4",
    "happy-dom": "20.11.1",
    "ioredis": "5.9.3",
    "jsonrepair": "^3.15.0",
    "nanoid": "^5.1.6",
    "next": "16.1.2",
    "parse5": "7.3.0",
    "pg": "8.16.3",
    "playwright-core": "1.60.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.5",
    "smiles-drawer": "2.4.1",
    "typebox": "^1.3.6",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@reachany/reach-deck-editor": "workspace:*",
    "@types/fontkit": "2.0.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@zip.js/zip.js": "2.7.62",
    "html-to-image": "1.11.13",
    "tailwindcss": "4.3.0",
    "tsx": "4.20.6",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
