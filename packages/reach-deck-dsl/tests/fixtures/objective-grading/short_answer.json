    {
      "name": "non-empty answer goes to AI",
      "question": {
        "question_type": "short_answer",
        "has_answer": true,
        "points": 10,
        "answer": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "证据链"
                }
              ]
            }
          ]
        },
        "sub_problems": []
      },
      "response": {
        "kind": "rich_text",
        "document": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "因为有证据"
                }
              ]
            }
          ]
        },
        "attachments": []
      },
      "expected": {
        "mode": "AI_REQUIRED",
        "maxScore": 10
      }
    },
