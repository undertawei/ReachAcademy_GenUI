{
  "name": "@reachany/importer",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pptx": {
      "types": "./dist/pptx/index.d.ts",
      "default": "./dist/pptx/index.js"
    },
    "./docx": {
      "types": "./dist/docx/index.d.ts",
      "default": "./dist/docx/index.js"
    },
    "./maic": {
      "types": "./dist/maic/index.d.ts",
      "default": "./dist/maic/index.js"
    },
    "./interactive-html": {
      "types": "./dist/interactive-html/index.d.ts",
      "default": "./dist/interactive-html/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1"
  },
  "devDependencies": {
    "@reachany/eslint-config": "workspace:*",
    "@reachany/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@reachany/reach-deck-dsl": "workspace:*",
    "@zip.js/zip.js": "2.7.62",
    "acorn": "8.16.0",
    "fast-xml-parser": "5.2.5",
    "katex": "0.16.33",
    "parse5": "7.3.0"
  }
}
