{
  "name": "@reachany/reach-deck-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
