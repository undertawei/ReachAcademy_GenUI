    "@reachany/reach-deck-dsl": "workspace:*",
    "@reachany/reach-deck-player": "workspace:*",
    "@reachany/reach-deck-rich-text": "workspace:^",
    "@reachany/tiptap-mathlive": "workspace:*",
    "@reachany/ui": "workspace:*",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-text-align": "3.28.0",
    "@tiptap/extension-text-style": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "@reachany/tsconfig": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^25.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
