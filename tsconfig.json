{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@reachany/reach-deck-dsl/euclidean-geometry": [
        "packages/reach-deck-dsl/src/euclideanGeometry.ts"
      ],
      "@reachany/reach-deck-dsl/euclidean-geometry-v2": [
        "packages/reach-deck-dsl/src/euclideanGeometryV2.ts"
      ],
      "@reachany/reach-deck-dsl/function-plot-geometry": [
        "packages/reach-deck-dsl/src/functionPlotGeometry.ts"
      ],
      "@reachany/reach-deck-dsl/euclidean-geometry-contract": [
        "packages/reach-deck-dsl/src/euclideanGeometryContract.json"
      ],
      "@reachany/reach-deck-dsl/euclidean-geometry-contract-v2": [
        "packages/reach-deck-dsl/src/euclideanGeometryContractV2.json"
      ],
      "@reachany/reach-deck-dsl/reference-library": [
        "packages/reach-deck-dsl/src/reference-library/index.ts"
      ],
      "@reachany/reach-deck-geometry/server": ["packages/reach-deck-geometry/src/server.ts"],
      "@reachany/reach-deck-geometry/session-v2": ["packages/reach-deck-geometry/src/sessionV2.ts"],
      "@reachany/importer/maic": ["packages/importer/src/maic/index.ts"],
      "@reachany/*": ["packages/*/src/index.ts"]
    }
  },
  "include": [
    "apps/workbench/src",
    "apps/workbench/server",
    "apps/workbench/shared",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
